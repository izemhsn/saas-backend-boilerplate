PORT=3000
NODE_ENV=development
# CORS — single origin or comma-separated list (e.g. "https://app.example.com,https://admin.example.com")
CORS_ORIGIN="http://localhost:3000"

# Logging — pino log level (trace, debug, info, warn, error, fatal)
# Defaults: debug (dev), info (prod), silent (test)
# LOG_LEVEL=debug

# Reverse proxy hops to trust for req.ip / rate limiting (e.g. 1 behind one proxy).
# Leave unset for local/direct connections. Accepts a number or an Express trust-proxy value.
# TRUST_PROXY=1

# Database (must match docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas-boilerplate_db"

# Connection pool — tunable so deployments can size it to their Postgres
# max_connections / instance count without code changes. All optional.
# DATABASE_POOL_MAX=10                     # max connections per process (default 10, pg default)
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000      # close idle connections after this (default 30s)
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000 # fail fast if no connection can be acquired (default 10s)

# Seeding — `npm run db:seed` creates demo accounts with a known password, so it
# refuses to run when NODE_ENV=production. Set to "true" to override deliberately.
# SEED_ALLOW_PRODUCTION="false"

# Redis (for BullMQ background jobs — must match docker-compose.yml)
REDIS_URL="redis://localhost:6379"
# Set to "true" to disable queue and process jobs inline (useful for debugging)
# JOB_QUEUE_DISABLED="false"
# Cron schedule for expired refresh-token cleanup (default: daily at 3 AM).
# Also drives the data-retention cleanup jobs below (2FA challenges, audit
# logs, notifications, terminal invitations) — they share this schedule.
# TOKEN_CLEANUP_CRON="0 3 * * *"

# Data retention — how long to keep rows before the maintenance worker prunes
# them. 2FA challenges have no equivalent var: they're always deleted once
# expired, since a used-up or expired challenge is never useful again.
# AUDIT_LOG_RETENTION_DAYS=365
# NOTIFICATION_RETENTION_DAYS=90
# INVITATION_RETENTION_DAYS=30       # terminal invitations only (accepted/declined/expired/canceled)
# FAILED_JOB_RETENTION_DAYS=90       # dead-lettered jobs (see FailedJob below)
# WEBHOOK_EVENT_RETENTION_DAYS=30    # Stripe idempotency ledger; must exceed Stripe's ~3d retry window

# JWT — MUST be unique, random, and at least 32 chars in production, and
# JWT_SECRET / JWT_REFRESH_SECRET must differ (all enforced at boot).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (Resend) — get your API key at https://resend.com/api-keys
RESEND_API_KEY=""
FROM_EMAIL="noreply@yourdomain.com"
# APP_URL is used to build the links in verification/reset/invitation emails.
# REQUIRED in production (enforced at boot) — left unset it silently falls
# back to localhost, so those emails point nowhere for real users.
APP_URL="http://localhost:3000"
# App name — used as the 2FA TOTP issuer label in authenticator apps
# APP_NAME="SaaS Boilerplate"

# Stripe — get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google OAuth — get your credentials at https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application). Set the authorized redirect URI
# to your frontend callback URL (e.g. http://localhost:5173/auth/google/callback).
# The frontend sends the authorization code to POST /api/auth/google.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="postmessage"

# Secret encryption — AES-256-GCM key for encrypting secrets at rest (e.g. 2FA TOTP secrets).
# If unset, derives from JWT_SECRET. Set independently for key rotation without changing JWT_SECRET.
# REQUIRED in production (enforced at boot): left unset, rotating JWT_SECRET
# later — a routine, recommended action — would make every stored 2FA secret
# undecryptable and permanently lock out every 2FA user.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SECRET_ENCRYPTION_KEY=""

# Sentry — error tracking & performance monitoring (optional, leave empty to disable)
# Get your DSN at https://sentry.io/settings/<org>/projects/<project>/keys/
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1