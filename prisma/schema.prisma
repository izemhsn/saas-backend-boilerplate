// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String    @id @default(cuid())
  // email/googleId/pendingEmail are intentionally NOT @unique here — they are
  // enforced by partial unique indexes scoped to live rows (WHERE "deletedAt"
  // IS NULL), created via raw SQL because Prisma's schema language cannot
  // express partial indexes. A soft-deleted user's email must be reusable by
  // a new signup; a plain @unique would make it permanently unusable. See
  // migration 20260823210000_tier2_correctness_and_data_safety.
  email                    String
  password                 String?
  name                     String?
  googleId                 String?
  role                     Role      @default(USER)
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  pendingEmail             String?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  tokenVersion             Int       @default(0)
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  banned                   Boolean   @default(false)
  bannedAt                 DateTime?
  suspendedUntil           DateTime?
  deletedAt                DateTime?
  twoFactorEnabled         Boolean   @default(false)
  twoFactorSecret          String?
  twoFactorBackupCodes     String[]
  // Highest otplib RFC-6238 timeStep (floor(unixEpoch / period), currently
  // ~30s buckets) accepted for this user so far. Passed back as
  // `afterTimeStep` on the next verify() call to reject replay of an
  // already-used TOTP code within its own 30s window (M16).
  lastTotpTimeStep         Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  stripeCustomerId       String?
  refreshTokens          RefreshToken[]
  memberships            OrganizationMember[]
  ownedOrganizations     Organization[]           @relation("OrgOwner")
  subscriptions          Subscription[]
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  sentInvitations        OrganizationInvitation[] @relation("InvitationInviter")
  receivedInvitations    OrganizationInvitation[] @relation("InvitationInvitee")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  createdProjects        Project[]

  twoFactorChallenges TwoFactorChallenge[]

  @@index([deletedAt])
  @@map("users")
}

model TwoFactorChallenge {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // M6: the maintenance worker's cleanupTwoFactorChallenges job deletes on
  // this column daily; without an index that's a full table scan.
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  userAgent String?
  ipAddress String?
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  ownerId          String
  // Set the first time the org starts a checkout (org-scoped billing, M12) —
  // mirrors User.stripeCustomerId, which is the equivalent for personal billing.
  stripeCustomerId String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner                User                      @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members              OrganizationMember[]
  invitations          OrganizationInvitation[]
  featureFlagOverrides OrganizationFeatureFlag[]
  projects             Project[]
  subscriptions        Subscription[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Worked example resource: the reference for how a tenant-scoped,
/// subscription-gated, feature-flagged resource is wired end to end.
/// See src/modules/project. Safe to delete wholesale when you build your own
/// domain model.
model Project {
  id             String        @id @default(cuid())
  organizationId String
  createdById    String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, deletedAt])
  @@index([createdById])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum Role {
  USER
  ADMIN
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model Plan {
  id            String       @id @default(cuid())
  name          String
  // Stable, immutable identifier used for access-control decisions —
  // subscription.middleware.js's requirePlan and PLAN-type feature flags
  // match on this, never on `name` (audit M11). `name` is a display string
  // adopters will rename; gating on it meant a rename could silently revoke
  // or grant paid access. Existing rows predating this column were
  // backfilled with their `id` (see the migration) since `name` had
  // duplicates in this dataset; give new plans a real slug ("pro", "enterprise").
  code          String       @unique
  description   String?
  stripePriceId String       @unique
  priceCents    Int
  currency      String       @default("usd")
  interval      PlanInterval
  features      Json         @default("{}")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  // Exactly one of userId/organizationId is set: personal billing scopes to
  // a user, org (B2B) billing scopes to an organization (M12). Prisma's
  // schema language can't express cross-column exclusivity, so a raw-SQL
  // CHECK constraint in the migration enforces it at the DB level too.
  userId               String?
  organizationId       String?
  planId               String
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  status               SubscriptionStatus
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  // Timestamp of the Stripe event that last wrote this row (event.created).
  // Stripe delivery is at-least-once and unordered, so a delayed event must
  // not be allowed to overwrite state written by a newer one — the webhook
  // handler only applies a write when its event is newer than this value.
  stripeEventCreatedAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@map("subscriptions")
}

// Records every successfully-parsed Stripe webhook event by its id, so a
// retried or resent delivery is a no-op instead of being reprocessed
// (Stripe's delivery guarantee is at-least-once). Never queried by the app
// beyond the insert-or-skip check in handleWebhook — see billing.service.js.
//
// Insert-only, one row per Stripe event, so it grows without bound on a busy
// account. The maintenance worker's cleanupProcessedWebhookEvents job prunes
// it past WEBHOOK_EVENT_RETENTION_DAYS, which is why createdAt is indexed —
// the job filters on that column alone.
model ProcessedWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("processed_webhook_events")
}

// M8: a BullMQ job that exhausts all its retry attempts is otherwise only
// logged (email.worker.js / maintenance.worker.js's `failed` handlers) and
// then dropped by `removeOnFail` — a verification or password-reset email
// that never sends is lost with nothing to alert on or requeue from. This
// table is the dead-letter record; see src/modules/jobs/deadLetter.js.
model FailedJob {
  id        String   @id @default(cuid())
  queue     String
  jobName   String
  jobData   Json
  error     String
  attempts  Int
  failedAt  DateTime @default(now())

  @@index([queue])
  @@index([failedAt])
  @@map("failed_jobs")
}

enum PlanInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  userId     String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

enum AuditAction {
  USER_REGISTER
  USER_LOGIN
  USER_OAUTH_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_BANNED
  USER_UNBANNED
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_ROLE_CHANGED
  USER_DELETED
  USER_RESTORED
  USER_PASSWORD_CHANGED
  USER_EMAIL_CHANGED
  ORG_CREATED
  ORG_UPDATED
  ORG_DELETED
  ORG_RESTORED
  ORG_OWNERSHIP_TRANSFERRED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  MEMBER_INVITED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_CANCELED
  API_KEY_CREATED
  API_KEY_REVOKED
  API_KEY_DELETED
  API_KEY_RESTORED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  CHECKOUT_STARTED
  PORTAL_OPENED
  FEATURE_FLAG_CREATED
  FEATURE_FLAG_UPDATED
  FEATURE_FLAG_DELETED
  FEATURE_FLAG_OVERRIDE_SET
  FEATURE_FLAG_OVERRIDE_REMOVED
  USER_DATA_EXPORTED
  USER_DATA_DELETED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  SESSION_REVOKED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  SESSIONS_REVOKED_ALL
}

model AuditLog {
  id             String      @id @default(cuid())
  action         AuditAction
  userId         String?
  targetUserId   String?
  organizationId String?
  ipAddress      String?
  userAgent      String?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetUserId])
  @@index([action])
  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  inviterId      String
  inviteeEmail   String
  inviteeId      String?
  role           OrgRole          @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  declinedAt     DateTime?
  canceledAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee      User?        @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  // inviteeEmail alone serves listMyInvitations (no organizationId in that
  // query's where-clause). The composite below serves createInvitation's
  // pending-duplicate check and listInvitations, both filtered on
  // organizationId — its leftmost prefix also covers plain organizationId
  // lookups, so the old standalone [organizationId] and [status] indexes
  // (audit M13) were redundant with it and are dropped in the migration.
  @@index([inviteeEmail])
  @@index([organizationId, inviteeEmail, status])
  @@map("organization_invitations")
}

enum NotificationType {
  SYSTEM
  ORGANIZATION
  BILLING
  SECURITY
  TEAM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([type])
  // M6: cleanupNotifications deletes on this column alone (no userId in its
  // where-clause), so it needs its own index rather than relying on the
  // userId-prefixed ones above.
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  inAppEnabled Boolean  @default(true)
  mutedTypes   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum FeatureFlagType {
  BOOLEAN
  PERCENTAGE
  PLAN
}

model FeatureFlag {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  description String?
  type        FeatureFlagType
  value       Json            @default("{}")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  overrides OrganizationFeatureFlag[]

  @@map("feature_flags")
}

model OrganizationFeatureFlag {
  id             String   @id @default(cuid())
  featureFlagId  String
  organizationId String
  enabled        Boolean  @default(true)
  value          Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  featureFlag  FeatureFlag  @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([featureFlagId, organizationId])
  @@index([organizationId])
  @@map("organization_feature_flags")
}
